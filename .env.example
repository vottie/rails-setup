# このファイルをコピーして .env を作成し、実際の値を設定してください。
# .env は .gitignore 対象のため、絶対にコミットしないこと。
#
#   cp .env.example .env
#
# Capistranoのデプロイ時 (config/deploy.rb) にDotenv経由で読み込まれます。

# --- development ステージ ---
DEVELOPMENT_HOST=
DEVELOPMENT_USER=
DEVELOPMENT_SSH_KEY_PATH=
# DEVELOPMENT_BRANCH=main

# --- staging ステージ(テスト環境) ---
STAGING_HOST=
STAGING_USER=
STAGING_SSH_KEY_PATH=
# STAGING_BRANCH=main

# --- production ステージ(本番環境) ---
PRODUCTION_HOST=
PRODUCTION_USER=
PRODUCTION_SSH_KEY_PATH=
# PRODUCTION_BRANCH=main
